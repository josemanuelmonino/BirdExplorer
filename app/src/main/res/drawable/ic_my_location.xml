<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo exterior translúcido -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3300796B" />
            <size
                android:width="36dp"
                android:height="36dp" />
        </shape>
    </item>

    <!-- Punto central con borde blanco -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#00796B" />
            <stroke
                android:width="2.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>